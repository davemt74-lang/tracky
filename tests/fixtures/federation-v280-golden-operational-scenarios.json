{
  "format": "physical_federation_v280_golden_operational_release.v1",
  "version": "2.80",
  "purpose": "Permanent V2.80 golden operational scenarios for federation authority, recovery, revocation, governed operations, upgrade and release hardening.",
  "invariants": [
    "origin-homeserver-is-authoritative",
    "cloud-is-request-relay-and-read-only-mirror",
    "agent-may-propose-never-execute",
    "reconnect-is-not-recovery",
    "command-success-is-not-recovery",
    "only-authoritative-reconciliation-restores-current",
    "stale-state-never-promotes-to-current",
    "authority-transfer-requires-explicit-confirmation",
    "authority-transfer-requires-epoch-advance",
    "old-authority-cannot-write-after-transfer",
    "conflicting-authority-claims-fail-closed",
    "revocation-wins-over-cached-grants",
    "revoked-device-cannot-regain-trust-from-replay",
    "governed-operation-idempotency-is-durable",
    "terminal-operation-state-is-immutable",
    "migration-053-is-repeat-safe",
    "production-packages-exclude-local-secrets-and-runtime-data"
  ],
  "scenarios": [
    {"id":"healthy-federation","kind":"health","input":{"state":"current","fresh":true,"recovery_complete":true},"expect":{"trusted_current":true}},
    {"id":"transport-partition","kind":"health","input":{"state":"partitioned","fresh":false,"recovery_complete":false},"expect":{"trusted_current":false}},
    {"id":"reconnect-before-reconciliation","kind":"health","input":{"state":"reconciling","fresh":false,"recovery_complete":false,"transport_connected":true},"expect":{"trusted_current":false}},
    {"id":"command-success-before-reconciliation","kind":"health","input":{"state":"recovering","fresh":false,"recovery_complete":false,"command_success":true},"expect":{"trusted_current":false}},
    {"id":"failed-reconciliation","kind":"health","input":{"state":"failed","fresh":false,"recovery_complete":false},"expect":{"trusted_current":false}},
    {"id":"successful-authoritative-reconciliation","kind":"health","input":{"state":"current","fresh":true,"recovery_complete":true,"reconciled":true},"expect":{"trusted_current":true}},
    {"id":"duplicate-operation-request","kind":"idempotency","input":{"same_key":true,"same_semantics":true},"expect":{"ledger_entries":1,"conflict":false}},
    {"id":"idempotency-semantic-conflict","kind":"idempotency","input":{"same_key":true,"same_semantics":false},"expect":{"ledger_entries":1,"conflict":true}},
    {"id":"restart-during-operation","kind":"operation_restart","input":{"before":"reconciling","durable":true},"expect":{"after":"reconciling","lost":false}},
    {"id":"authority-transfer","kind":"authority_transfer","input":{"explicit":true,"source_current":true,"epoch_before":7,"epoch_after":8,"reconciliation_current":false},"expect":{"accepted":true,"old_authority_writable":false,"trusted_current":false}},
    {"id":"authority-transfer-complete","kind":"authority_transfer","input":{"explicit":true,"source_current":true,"epoch_before":7,"epoch_after":8,"reconciliation_current":true},"expect":{"accepted":true,"old_authority_writable":false,"trusted_current":true}},
    {"id":"authority-transfer-no-epoch-advance","kind":"authority_transfer","input":{"explicit":true,"source_current":true,"epoch_before":7,"epoch_after":7,"reconciliation_current":true},"expect":{"accepted":false,"old_authority_writable":true,"trusted_current":false}},
    {"id":"conflicting-authority-claims","kind":"authority_conflict","input":{"claim_count":2,"same_epoch":true},"expect":{"state":"failed","fail_closed":true}},
    {"id":"site-revocation-with-cached-grant","kind":"revocation","input":{"site_revoked":true,"cached_grant":true},"expect":{"allowed":false,"revocation_wins":true}},
    {"id":"device-revocation-with-replay","kind":"device_revocation","input":{"trust_state":"revoked","replayed_trusted_state":true},"expect":{"effective_trust":"revoked"}},
    {"id":"cloud-unavailable-local-ledger","kind":"cloud_outage","input":{"cloud_available":false,"local_ledger_durable":true},"expect":{"local_operations_available":true,"authority_unchanged":true}},
    {"id":"cloud-cannot-execute","kind":"cloud_boundary","input":{"cloud_request":true},"expect":{"execute":false,"authority_mutation":false}},
    {"id":"agent-cannot-execute","kind":"agent_boundary","input":{"agent_proposal":true},"expect":{"execute":false,"proposal_only":true}},
    {"id":"cancel-operation","kind":"terminal","input":{"terminal":"cancelled","next":"running"},"expect":{"next_allowed":false}},
    {"id":"expire-operation","kind":"terminal","input":{"terminal":"expired","next":"running"},"expect":{"next_allowed":false}},
    {"id":"staged-update-request","kind":"update","input":{"package_checksum_valid":true,"release_version":"2.4","rollout_id":19},"expect":{"request_accepted":true,"installed_by_request":false}},
    {"id":"migration-053-repeat","kind":"migration","input":{"latest":53,"repeat":true},"expect":{"latest":53,"repeat_safe":true}},
    {"id":"privacy-release-package","kind":"privacy","input":{"raw_media":false,"credentials":false,"local_paths":false,"semantic_summary":true},"expect":{"safe":true}},
    {"id":"route-collision-audit","kind":"routes","input":{"legacy_route_count":1,"governed_route_count":1},"expect":{"unique":true}}
  ]
}